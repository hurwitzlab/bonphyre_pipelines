// Pipeline info
params.pipeline_name    = 'i_mg_viralinference'
params.workflow_version = '1.0.0'

// Include needed configs
includeConfig '../../conf/site.config'
includeConfig '../../nextflow.config'
includeConfig '../../conf/base.config'

// No default for project_id, must be provided
params.project_id = null

// Set the directory for the outputs
params.outdir = "${params.data_lake_dir}/${params.project_id}/${params.pipeline_name}/${params.workflow_version}"



// ================================================================================
//                   ILLUMINA METAGENOMICS VIRAL INFERENCE
// ================================================================================
manifest {
    name                    = params.pipeline_name
    author                  = 'Mery Touceda-Suarez'
    homePage                = ''
    description             = 'Nextflow pipelines configuration file'
    mainScript              = 'i_mg_viralinference.nf'
    nextflowVersion         = '>=22.10.0'
    version                 = params.workflow_version
}


// ================================================================================
//                           Set default parameters
// ================================================================================
/*
Any parameters provided by the user with a -params-file or
with -- command-line arguments will override the values defined below.
*/
params {

    // ================================================================================
    //                              CLEANUP
    // ================================================================================
    save_intermediates = false  // set to true to keep intermediate files for debugging
                                // can be overriden at runtime (e.g. $: nextflow run main.nf --save_intermediates true)


    // ================================================================================
    //                              INPUT/OUTPUT PARAMETERS
    // ================================================================================
    reads                    = '/rs1/researchers/b/blhurwit/users/mtouced/nf_test_data/*_R{1,2}.fastq.gz'     // Path to input reads, we are passing it as a command-line argument
    // Example: reads = '/path/to/your/reads/*_{1,2}.fastq.gz'

   

    // ================================================================================
    //                              DATABASE PATHS
    // ================================================================================
    illumina_adapters_file    = "${params.databases_dir}/adapters/bbduk_illumina_adapters.fa"       //path to your adapters file, if not provided bbduk will use its default adapters file
    genomad_db                = "${params.databases_dir}/genomad_db"               // TODO: confirm actual path/db version
    checkv_db                 = "${params.databases_dir}/checkv_db"                // TODO: confirm actual path/db version

    // ================================================================================
    //                              SINGULARITY CONTAINERS
    // ================================================================================
    container__bbmap        = "${params.singularity_images_dir}/quay.io_biocontainers_bbmap:40.04--h09cc210_0.sif"   // used by bbduk, bbwrap and pileup; BBTools 39.76-40.01 crash in bbduk on paired reads, use >= 40.04
    container__trimmomatic  = "${params.singularity_images_dir}/quay.io_biocontainers_trimmomatic:0.40--hdfd78af_0.sif"
    container__genomad      = "${params.singularity_images_dir}/TODO_genomad.sif"      // TODO: fill in actual image, was missing entirely
    container__checkv       = "${params.singularity_images_dir}/TODO_checkv.sif"       // TODO: fill in actual image, was missing entirely
    container__seqkit       = "${params.singularity_images_dir}/quay.io_biocontainers_seqkit:2.13.0--he881be0_0.sif"       // read-count QC metrics
    container__metrics      = "${params.singularity_images_dir}/TODO_metrics.sif"      // TODO: fill in actual image (python3 + pandas, for bin/summarize_viral_filter.py)


    // ================================================================================
    //                              TOOL-SPECIFIC PARAMETERS
    // ================================================================================

    // BBDuk parameters
    bbduk_ktrim             = "r"        // Trim reads to remove bases matching reference kmers from right end
    bbduk_k                 = 23         // Kmer length used for finding contaminants
    bbduk_mink              = 11         // Look for shorter kmers at read tips down to this length
    bbduk_hdist             = 1          // Maximum Hamming distance for ref kmers
    bbduk_additional_flags  = "tpe tbo"  // Trim both reads to same length (tpe) and trim adapters based on pair overlap (tbo)

    // Trimmomatic parameters
    java_mem                  = "32G"     // memory space where Java programs store objects and data while running
    trimmomatic_leading       = 20       // Remove leading low quality bases below this threshold
    trimmomatic_trailing      = 20       // Remove trailing low quality bases below this threshold
    trimmomatic_slidingwindow = "4:15"   // Scan read with sliding window, cutting when average quality drops below threshold
    trimmomatic_minlen        = 50       // Drop reads below this length

    // MEGAHIT parameters
    megahit_preset = "meta-large"
    megahit_kmin  = 21   // <int> minimum kmer size (<= 127), must be odd number, default 21
    megahit_kmax  = 99   // <int> maximum kmer size (<= 127), must be odd number, default 99
    megahit_kstep = 28   // <int> increment of kmer size of each iteration (<= 28)

    // BBmap parameters
    bbmap_kfilter   = 22
    bbmap_subfilter = 15
    bbmap_maxindel  = 80

    // ================================================================================
    //                              QC THRESHOLDS
    // ================================================================================
    // Used by subworkflow metrics steps to flag problem samples with log.warn
    // during the run (see subworkflows/CLAUDE.md). Not enforced (the pipeline
    // doesn't fail the sample) -- just surfaced for review.
    qc_min_pct_reads_retained = 50   // warn if fewer than this % of raw reads survive QC/trimming
    qc_min_viral_contigs      = 1    // warn if a sample yields zero contigs passing genomad/checkv

}
