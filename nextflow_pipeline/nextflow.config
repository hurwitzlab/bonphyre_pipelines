// ================================================================================
//                        REPO-WIDE NEXTFLOW CONFIGURATION
// ================================================================================
// Included by every pipeline's own config (workflows/<name>/<name>.config).
// Do not add pipeline-specific or tool-specific params here — those belong in
// the pipeline's own .config file.

includeConfig 'conf/site.config'
includeConfig 'conf/base.config'

// Nextflow settings
cleanup = true

// ================================================================================
//                          RUN REPORTING / EXECUTION METRICS
// ================================================================================
// Per-process resource usage (cpu, memory, time, exit status, retries) for
// every run of every pipeline that includes this file. This is what tells
// you the pipeline itself ran correctly — a non-zero exit, a retried task,
// or one sample taking far longer/more memory than its peers all show up
// here. Custom benchmark/QC metrics (read survival, viral yield, etc.) are
// a separate concern handled per-subworkflow — see subworkflows/CLAUDE.md.
//
// These paths are built from params.outdir, which is only defined by the
// *including* pipeline config, not this file. Every workflow config that
// includes this file must set `params.outdir` BEFORE its `includeConfig
// '../../nextflow.config'` line (see i_mg_viralinference.config), otherwise
// these resolve to "null/pipeline_info/...".
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/trace_${new Date().format('yyyyMMdd_HHmmss')}.tsv"
    fields  = 'task_id,tag,process,status,exit,attempt,submit,duration,realtime,%cpu,peak_rss,peak_vmem'
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/report_${new Date().format('yyyyMMdd_HHmmss')}.html"
}
timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/timeline_${new Date().format('yyyyMMdd_HHmmss')}.html"
}

// ================================================================================
//                              EXECUTION PROFILES
// ================================================================================
// Choose container engine + executor at runtime, e.g.:
//   nextflow run i_mg_viralinference.nf -profile hazel
//
// To support a new machine/cluster, add a new profile here — never edit a
// workflow's .config or .nf file to do it.
profiles {

    hazel {
        process {
            executor     = 'slurm'
            cpus         = 2
            memory       = 4.GB
            time         = 1.h
            beforeScript = 'module load singularity'

            resourceLimits = [
                memory: 128.GB,
                cpus:   24,
                time:   120.h
            ]
        }

        singularity {
            enabled    = true
            autoMounts = true
            cacheDir   = System.getenv('APPTAINER_CACHEDIR') ?: "/share/${System.getenv('GROUP')}/${System.getenv('USER')}/tmp"

            // autoMounts doesn't bind Hazel's system $TMPDIR, breaking tools that use it
            runOptions = '-B ${TMPDIR:-/tmp}'
        }
    }

    local {
        process.executor       = 'local'
        singularity.enabled    = true
        singularity.autoMounts = true
    }

    // Add further cluster profiles here, following the `hazel` pattern.
}
