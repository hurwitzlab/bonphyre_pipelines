// ================================================================================
//                              SITE CONFIGURATION
// ================================================================================
// Edit THIS ONE FILE to point every pipeline in this repo at your reference
// databases and prebuilt container images on a new machine/cluster.
//
// Nothing here should ever change per run or per pipeline:
//   - per-run values (reads, outdir, ...) are passed as --flags at the command line
//   - container engine / executor is chosen with -profile (see ../nextflow.config)
//
// Defined under params so any workflow config that includes this file (via
// ../../nextflow.config) can interpolate them, e.g.:
//   illumina_adapters_file = "${params.databases_dir}/adapters/bbmap_adapters/adapters.fa"

params {
    databases_dir          = '/path/to/databases'            // TODO: set to your reference database root
    singularity_images_dir = '/path/to/singularity_images'   // TODO: set to your prebuilt .sif image directory
    data_lake_dir          = '/path/to/data_lake'             // TODO: set to your data lake root -- every pipeline's
                                                               // outdir is built as "${data_lake_dir}/<project_id>/<pipeline_name>/<workflow_version>"
}
