// ================================================================================
//                          DEFAULT PROCESS RESOURCES
// ================================================================================
// How much CPU/memory/time each process needs — a property of the pipeline
// and its tools, not of the site it runs on. This is why it lives here and
// not in conf/site.config or a profile: it applies the same regardless of
// which machine/cluster/profile you run with.
//
// A profile (see ../nextflow.config) may still cap what's actually available
// via `resourceLimits`, and always wins over these values when it does.
//
// Modules pick a tier with `label "process_<tier>"` as the first line inside
// their `process { ... }` block (see modules/CLAUDE.md).

// ================================================================================
//                    CENTRALIZED publishDir (label-based)
// ================================================================================
// A process publishes here by carrying a SECOND label -- "publish_intermediate"
// or "publish_final" -- alongside its resource label, and nothing else: no
// `publishDir` directive of its own (see nextflow_modules/modules/CLAUDE.md's
// "Alternative" bullet). The withLabel: blocks below are what actually give it
// a publishDir, dispatched per-process via task.process.
//
// mode defaults, overridable per run like any other param:
params.publish_mode_intermediate = 'symlink'
params.publish_mode_final        = 'copy'

// task.process is fully-qualified with its subworkflow path (e.g.
// "s_i_mg_readqc:trimmomatic"), so this strips it down to the bare process
// name before looking up that process's own params.<tool>_outdir -- which,
// same as the in-module Closure convention it replaces, may be a plain path
// or a Closure taking sampleid.
//
// Written as one expression, not `def outdirParam = ...` followed by a
// second statement referencing it: config files reject that with
// "outdirParam is not defined" (a stricter subset of Groovy than a .nf
// script's shell:/workflow{} bodies allow -- verified against this
// installed Nextflow version) -- same class of restriction as `if`/`exit`
// not being valid top-level config statements (see i_mg_viralinference.nf).
params.resolvePublishDir = { processFqName, sampleid ->
    (params["${processFqName.tokenize(':').last()}_outdir"] instanceof Closure)
        ? params["${processFqName.tokenize(':').last()}_outdir"](sampleid)
        : params["${processFqName.tokenize(':').last()}_outdir"]
}

process {
    cpus   = { 1      * task.attempt }
    memory = { 6.GB   * task.attempt }
    time   = { 4.h    * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'finish' }
    maxRetries    = 1
    maxErrors     = '-1'

    withLabel:process_single {
        cpus   = { 1                   }
        memory = { 6.GB * task.attempt }
        time   = { 4.h  * task.attempt }
    }
    withLabel:process_low {
        cpus   = { 2     * task.attempt }
        memory = { 12.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
    withLabel:process_medium {
        cpus   = { 6     * task.attempt }
        memory = { 36.GB * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel:process_high {
        cpus   = { 12    * task.attempt }
        memory = { 72.GB * task.attempt }
        time   = { 16.h  * task.attempt }
    }

    withLabel:publish_intermediate {
        publishDir = [
            path: { params.resolvePublishDir(task.process, sampleid) },
            mode: params.publish_mode_intermediate,
        ]
    }
    withLabel:publish_final {
        publishDir = [
            path: { params.resolvePublishDir(task.process, sampleid) },
            mode: params.publish_mode_final,
        ]
    }
}
