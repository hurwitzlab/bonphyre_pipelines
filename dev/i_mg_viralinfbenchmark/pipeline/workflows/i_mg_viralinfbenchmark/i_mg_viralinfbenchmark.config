// Pipeline info
params.pipeline_name    = 'i_mg_viralinfbenchmark'
params.workflow_version = '1.0.0'

// Include needed configs
includeConfig '../../conf/site.config' //environment
includeConfig '../../conf/base.config' //process resources and publish
includeConfig '../../nextflow.config'  //pipeline params


// Output directory info
params.project_id = null // No default for project_id, must be provided

// Set the directory for the outputs
params.outdir = "${params.data_lake_dir}/${params.project_id}/${params.pipeline_name}/${params.workflow_version}"


// ================================================================================
//                   ILLUMINA METAGENOMICS VIRAL INFERENCE
// ================================================================================
manifest {
    name                    = params.pipeline_name
    author                  = 'Mery Touceda-Suarez'
    homePage                = ''
    description             = 'Viral inference benchmark pipeline'
    mainScript              = 'i_mg_viralinfbenchmark.nf'
    nextflowVersion         = '>=22.10.0'
    version                 = params.workflow_version
}


// ================================================================================
//                           Set default parameters
// ================================================================================
/*
Any parameters provided by the user with a -params-file or
with -- command-line arguments will override the values defined below.
*/
params {

    // ================================================================================
    //                              INPUT/OUTPUT PARAMETERS
    // ================================================================================
    reads 		        = null   //test data (marvel only -- should be QC'd reads)
    contigs                  = null     // Required: path to contigs, e.g. '/path/to/contigs/*/contigs.fa' (sampleid = parent dir name)
    help                     = false    // Print the help message and exit

   
    // ================================================================================
    //                              DATABASE PATHS
    // ================================================================================
    illumina_adapters_file    = "${params.databases_dir}/adapters/bbduk_illumina_adapters.fa"       //path to your adapters file, if not provided bbduk will use its default adapters file
    genomad_db                = "${params.databases_dir}/genomad_db/genomad_db/"
    viralm_db                 = "${params.databases_dir}viralm_model/model" ///rs1/researchers/b/blhurwit/users/sraoufi/benchmark/viralm_model/model"       // DNABERT-2 + fine-tuned weights (from viralm/config.sh)
    virsorter2_db             = "${params.databases_dir}/TODO_virsorter2_db"                                   // TODO: fill in actual path
    virrep_script             = "${params.databases_dir}virrep/src_patched/VirRep.py" ///rs1/researchers/b/blhurwit/users/sraoufi/benchmark/virrep/src_patched/VirRep.py"  // patched copy (weights_only fix)               

    // ================================================================================
    //                              SINGULARITY CONTAINERS
    // ================================================================================
    container__deepmicroclass2 = "${params.singularity_images_dir}/DeepMicroClass2-git-9622bd6.sif"
    container__deepvirfinder   = "${params.singularity_images_dir}/DeepVirFinder.1.0.sif"
    container__genomad         = "${params.singularity_images_dir}/TODO_genomad.sif"      // TODO: fill in actual image
    container__marvel          = "${params.singularity_images_dir}/TODO_marvel.sif"       // TODO: fill in actual image
    container__vibrant         = "${params.singularity_images_dir}/TODO_vibrant.sif"      // TODO: fill in actual image
    container__viralm          = "${params.singularity_images_dir}/ViraLM-git-b7a6f4e.sif"
    container__virrep          = "${params.singularity_images_dir}/VirRep-git-7c7b4b8.sif"
    container__virsorter2      = "${params.singularity_images_dir}/TODO_virsorter2.sif"   // TODO: fill in actual image
    
    container__seqkit       = "${params.singularity_images_dir}/quay.io_biocontainers_seqkit:2.13.0--he881be0_0.sif"       // TODO: fill in actual image (read-count QC metrics)
    

    // ================================================================================
    //                              TOOL-SPECIFIC PARAMETERS
    // ================================================================================

    // Viral inference: shared minimum contig length (deepvirfinder, virsorter2)
    viralinference_minlength = 1500

    // DeepMicroClass2 parameters
    deepmicroclass2_model    = "8class"   // default model, as in the source benchmark

    // VIBRANT parameters
    vibrant_f                = "nucl"     // input is nucleotide contigs
    vibrant_minlength        = 1000       // VIBRANT default
    vibrant_minorfspercontig = 4          // VIBRANT default

    // ViraLM parameters
    viralm_minlen            = 500        // keep all fragments incl. 500 nt
    viralm_threshold         = 0.5        // paper's recommended operating point

    // VirRep parameters
    virrep_minlen            = 1000
    virrep_window            = 2
    virrep_model             = "/opt/VirRep/src/model/VirRep.pth"   // model inside the image



}
