// ================================================================================
//                              SITE CONFIGURATION
// ================================================================================
// Edit THIS ONE FILE to point every pipeline in this repo at your reference
// databases and prebuilt container images on a new machine/cluster.

params {
    databases_dir          = '/rs1/shares/brc/admin/databases'			// set to your reference database root
    singularity_images_dir = '/usr/local/usrapps/brc/brc_modules/images'   	// set to your prebuilt .sif image directory
    singularity_images_dev = '/usr/local/usrapps/brc/developer_tools/images'	// for images under development
    data_lake_dir          = '/share/ivirus/mtouceda'                        // set to your data lake root -- every pipeline's
                                                                            // outdir is built as "${data_lake_dir}/<project_id>/<pipeline_name>/<workflow_version>"
}

